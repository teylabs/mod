{
    "name": "tey/mod",
    "description": "A layout-neutral generation and discovery engine for Laravel applications.",
    "keywords": [
        "tey",
        "laravel",
        "mod",
        "modules",
        "layout",
        "generators",
        "scaffolding",
        "discovery"
    ],
    "homepage": "https://github.com/teylabs/mod",
    "license": "MIT",
    "authors": [
        {
            "name": "Jasper Tey",
            "email": "jasper@teylabs.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/teylabs/mod/issues",
        "source": "https://github.com/teylabs/mod"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "suggest": {
        "lorisleiva/laravel-actions": "Used by the ddd layout's mod:action when installed",
        "spatie/laravel-data": "Used by the ddd layout's mod:dto when installed",
        "spatie/laravel-view-models": "Used by the ddd layout's mod:view-model when installed"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tey\\Mod\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tey\\Mod\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G",
            "vendor/bin/phpstan analyse -c phpstan.tests.neon.dist --memory-limit=1G"
        ],
        "test": "vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tey\\Mod\\ModServiceProvider"
            ],
            "aliases": {
                "Mod": "Tey\\Mod\\Facades\\Mod"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
