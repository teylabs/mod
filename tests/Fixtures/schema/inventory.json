                    "type": {
                      "type": "string"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "stub": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "options": {
                      "type": [
                        "object",
